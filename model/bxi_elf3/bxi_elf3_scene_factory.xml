         (no ground contact, no interference with the robot's walking) -->
    <body name="agv_0" pos="4.0 4.0 0.04" mocap="true">
      <geom name="agv_0_geom" type="sphere" size="0.2" material="agv0_mat" contype="1" conaffinity="1"/>
