  <statistic center="7.5 5.0 0.8" extent="9.5" meansize="0.1"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.1 0.1 0.1" specular="0 0 0"/>
    <global azimuth="180" elevation="-30"/>
  </visual>

  <asset>
    <texture name="floor_tex" type="2d" builtin="flat" rgb1=".58 .62 .60" rgb2=".50 .54 .52" width="128" height="128" mark="random" markrgb=".52 .56 .54"/>
    <material name="floor_mat" texture="floor_tex" texrepeat="20 15" texuniform="true" reflectance="0.03"/>
    <material name="shelf_mat" rgba="0.5 0.45 0.4 1"/>
    <material name="equip_mat" rgba="0.4 0.5 0.55 1"/>
    <material name="agv0_mat" rgba="0.9 0.3 0.2 1"/>
    <material name="agv1_mat" rgba="0.2 0.5 0.9 1"/>
    <material name="agv2_mat" rgba="0.2 0.7 0.3 1"/>
    <material name="agv3_mat" rgba="0.9 0.7 0.1 1"/>
    <material name="lm000_mat" rgba="0.2 0.8 0.2 0.6"/>
    <material name="lm001_mat" rgba="0.2 0.8 0.2 0.6"/>
    <material name="lm002_mat" rgba="0.9 0.5 0.1 0.6"/>
    <material name="lm003_mat" rgba="0.9 0.5 0.1 0.6"/>
    <material name="lm004_mat" rgba="0.8 0.3 0.8 0.6"/>
    <material name="lm005_mat" rgba="0.2 0.8 0.8 0.6"/>
    <material name="lm006_mat" rgba="0.2 0.8 0.8 0.6"/>
  </asset>

  <worldbody>
    <light pos="7.5 5.0 6" directional="true"/>
    <geom name="ground" type="plane" pos="0 0 -0.16" size="30 30 0.1" material="floor_mat" friction="1.0 0.1 0.1"/>

    <body name="obs_0" pos="9.0 8.0 0.84">
      <geom name="obs_0_geom" type="box" size="1.5 0.35 1.00" material="shelf_mat"/>
    </body>
    <body name="obs_1" pos="9.0 5.0 0.84">
      <geom name="obs_1_geom" type="box" size="1.5 0.35 1.00" material="shelf_mat"/>
    </body>
    <body name="obs_2" pos="6.5 1.0 0.59">
      <geom name="obs_2_geom" type="box" size="1.0 0.5 0.75" material="equip_mat"/>
    </body>
    <body name="obs_3" pos="4.0 5.0 0.84">
      <geom name="obs_3_geom" type="box" size="1.5 0.35 1.00" material="shelf_mat"/>
    </body>
    <body name="obs_4" pos="4.0 8.0 0.84">
      <geom name="obs_4_geom" type="box" size="1.5 0.35 1.00" material="shelf_mat"/>
